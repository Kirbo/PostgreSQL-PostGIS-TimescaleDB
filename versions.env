# Single source of truth for the component versions baked into the image.
#
# RESOLVE_MODE=auto   the weekly schedule calls scripts/resolve-versions.sh, and when the newest
#                     COMBINATION upstream actually ships for every arch (see the script header)
#                     differs from the pins below, commits the new pins — that commit's pipeline
#                     builds and publishes. The pins are the floor/ceiling for the search.
# RESOLVE_MODE=pinned the schedule does nothing; the pins below change only by hand.
# Either way EVERY pipeline builds exactly the versions pinned below.
RESOLVE_MODE=auto

# Debian suite of the base image: postgres:${PG_VERSION}-${DEBIAN_SUITE}.
# PGDG (PostGIS) and packagecloud (TimescaleDB) must both publish for this suite.
DEBIAN_SUITE=trixie

PG_MAJOR=18
PG_VERSION=18.6
POSTGIS_VERSION=3.6.4
TIMESCALEDB_VERSION=2.30.0
# Manifest-list digest of postgres:${PG_VERSION}-${DEBIAN_SUITE}. The FROM is pinned to it, so
# a build is reproducible, and a rebuild of the base image by docker-library (Debian security
# updates) counts as "something newer upstream": the schedule commits the new digest and the
# commit's pipeline republishes.
PG_IMAGE_DIGEST=sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280

# Search bounds for RESOLVE_MODE=auto. The resolver walks PostgreSQL majors down from
# MAX_PG_MAJOR and takes the first one that has a stable base image AND a PostGIS AND a
# TimescaleDB package for every target arch — so a new major is picked up on its own once
# both extensions ship for it. Raise MAX_PG_MAJOR when PostgreSQL 21 is on the horizon.
MIN_PG_MAJOR=15
MAX_PG_MAJOR=20

# Architectures the published image is built for (also what the resolver requires packages for).
PLATFORMS=linux/amd64,linux/arm64
