# Single source of truth for the component versions baked into the image.
#
# RESOLVE_MODE=auto   CI calls scripts/resolve-versions.sh at pipeline time and builds the
#                     newest COMBINATION that upstream actually ships for every arch (see the
#                     script header). The pins below are then only a fallback for when an
#                     upstream lookup fails, plus the floor/ceiling for the search.
# RESOLVE_MODE=pinned CI builds exactly the versions pinned below. Edit a number, push, get
#                     that image — nothing else to touch.
RESOLVE_MODE=auto

# Debian suite of the base image: postgres:${PG_VERSION}-${DEBIAN_SUITE}.
# PGDG (PostGIS) and packagecloud (TimescaleDB) must both publish for this suite.
DEBIAN_SUITE=trixie

PG_MAJOR=18
PG_VERSION=18.6
POSTGIS_VERSION=3.6.4
TIMESCALEDB_VERSION=2.30.0

# Search bounds for RESOLVE_MODE=auto. The resolver walks PostgreSQL majors down from
# MAX_PG_MAJOR and takes the first one that has a stable base image AND a PostGIS AND a
# TimescaleDB package for every target arch — so a new major is picked up on its own once
# both extensions ship for it. Raise MAX_PG_MAJOR when PostgreSQL 21 is on the horizon.
MIN_PG_MAJOR=15
MAX_PG_MAJOR=20

# Architectures the published image is built for (also what the resolver requires packages for).
PLATFORMS=linux/amd64,linux/arm64
